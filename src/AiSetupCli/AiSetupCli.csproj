<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AiSetup.Cli</RootNamespace>
    <AssemblyName>AiSetupCli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ai-setup</ToolCommandName>
    <PackageId>AiSetupCli</PackageId>
    <Description>CLI to deploy AI assets (agents, skills, instructions, MCP configs) to Copilot CLI and Claude Code.</Description>
    <PackageOutputPath>../../artifacts</PackageOutputPath>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiSetupLib\AiSetupLib.csproj" />
  </ItemGroup>

</Project>
