<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AiSetup.Cli</RootNamespace>
    <AssemblyName>ai-setup</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ai-setup</ToolCommandName>
    <PackageId>AiSetup.Cli</PackageId>
    <Description>CLI for managing and deploying AI assistant configurations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiSetupLib\AiSetupLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
